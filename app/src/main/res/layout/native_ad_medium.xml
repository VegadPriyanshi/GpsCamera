<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_native_ad_card"
    android:padding="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/adIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/adBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_ad_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="Ad"
            android:textColor="@color/white"
            android:textSize="10sp"
            app:layout_constraintStart_toEndOf="@id/adIcon"
            app:layout_constraintTop_toTopOf="@id/adIcon" />

        <TextView
            android:id="@+id/adHeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/navy"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/adMedia"
            app:layout_constraintStart_toEndOf="@id/adBadge"
            app:layout_constraintTop_toTopOf="@id/adIcon"
            tools:text="Headline" />

        <TextView
            android:id="@+id/adAdvertiser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/adMedia"
            app:layout_constraintStart_toStartOf="@id/adIcon"
            app:layout_constraintTop_toBottomOf="@id/adIcon"
            tools:text="Advertiser" />

        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/adMedia"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/adBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/navy_muted"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/adMedia"
            app:layout_constraintStart_toStartOf="@id/adIcon"
            app:layout_constraintTop_toBottomOf="@id/adAdvertiser" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/ctaTopBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="adBody,adMedia" />

        <TextView
            android:id="@+id/adCallToAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_blue"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/adMedia"
            app:layout_constraintStart_toStartOf="@id/adIcon"
            app:layout_constraintTop_toBottomOf="@id/ctaTopBarrier"
            tools:text="Install" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
